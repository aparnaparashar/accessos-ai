# --- Core ---
MONGODB_URI=mongodb://localhost:27017/accessos
REDIS_URL=redis://localhost:6379

# --- CORS (Section 14) ---
# Comma-separated list of origins allowed to call this API directly from a
# browser. Defaults to http://localhost:4200 (the Angular dev server) if
# unset, so local dev works without a .env file. Add your deployed frontend
# origin here once you have one.
ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- AI provider abstraction (Orchestrator) ---
# One of: openai | gemini | claude  — leave unset to fail closed with
# {"error":"capability_not_configured"} exactly as documented in Section 09.
AI_PROVIDER_VISION=
AI_PROVIDER_TEXT=
AI_PROVIDER_AUDIO=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Rate limiting (Section 11) ---
RATE_LIMIT_FREE_PER_DAY=100
RATE_LIMIT_STARTER_PER_DAY=10000
RATE_LIMIT_PRO_PER_DAY=500000

# --- API key signing (Section 12) ---
SIGNATURE_NONCE_TTL_SECONDS=300

# --- Billing (Section 10/12) — leave unset to fail closed with
# {"error":"capability_not_configured"} on POST /v1/billing/checkout ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
APP_URL=http://localhost:4200
